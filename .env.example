# ── FRONTEND (Next.js) settings ───────────────────────────────────────────────
# Copy to .env and fill in. Backend settings live in the backend's .env, not here.
# On Vercel, set these under Settings → Environment Variables instead (then redeploy).

NEXT_PUBLIC_APP_NAME=ProofChain
NEXT_PUBLIC_ENV=development

# Where Next.js forwards /api/* (server-side only)
#   local:  http://localhost:3001
#   live:   https://proofchain-backend-q03r.onrender.com
BACKEND_URL=http://localhost:3001

# Optional: the browser calls the backend directly instead of through /api.
# Leave empty on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Other devices on your network that may open the dev server (comma-separated LAN IPs)
ALLOWED_DEV_ORIGINS=
